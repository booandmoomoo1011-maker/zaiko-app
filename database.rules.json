{
  "rules": {
    ".read": false,
    ".write": false,
    "zaiko": {
      "history": {
        ".read": true,
        ".write": true
      },
      "items": {
        ".read": true,
        ".write": true
      },
      "sales": {
        ".read": true,
        ".write": true
      },
      "temp_records": {
        ".read": true,
        ".write": true
      },
      "warabi_master": {
        ".read": true,
        ".write": true
      },
      "warabi_records": {
        ".read": true,
        ".write": true
      },
      "app_access": {
        "tokens": {
          "$token": {
            ".read": "auth != null && (root.child('zaiko/shift/access/admins').child(auth.uid).val() === true || root.child('zaiko/app_access/sessions').child(auth.uid).val() === $token)",
            ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
            ".validate": "newData.val() === null || (newData.hasChildren(['active','app','storeKey','storeName']) && newData.child('active').isBoolean() && newData.child('app').isString() && newData.child('storeKey').isString() && newData.child('storeName').isString())"
          }
        },
        "byAppStore": {
          "$app": {
            "$storeKey": {
              ".read": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
              ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
              ".validate": "newData.val() === null || newData.isString()"
            }
          }
        },
        "sessions": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('zaiko/shift/access/admins').child(auth.uid).val() === true)",
            ".write": "auth != null && auth.uid === $uid && newData.isString() && root.child('zaiko/app_access/tokens').child(newData.val()).child('active').val() === true"
          }
        }
      },
      "shift": {
        ".read": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
        "access": {
          "admins": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid && data.val() === true",
              ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
              ".validate": "newData.val() === true || newData.val() === null"
            }
          },
          "tokens": {
            "$token": {
              ".read": "auth != null && (root.child('zaiko/shift/access/admins').child(auth.uid).val() === true || root.child('zaiko/shift/sessions').child(auth.uid).val() === $token)",
              ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
              ".validate": "newData.val() === null || (newData.hasChildren(['active','staffKey','name','store']) && newData.child('active').isBoolean() && newData.child('staffKey').isString() && newData.child('name').isString() && newData.child('store').isString())"
            }
          },
          "byStaff": {
            ".read": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true"
          },
          "editorTokens": {
            "$token": {
              ".read": "auth != null && (root.child('zaiko/shift/access/admins').child(auth.uid).val() === true || root.child('zaiko/shift/access/editorSessions').child(auth.uid).val() === $token)",
              ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
              ".validate": "newData.val() === null || (newData.hasChildren(['active','slot']) && newData.child('active').isBoolean() && newData.child('slot').isString())"
            }
          },
          "editorSlots": {
            "$slot": {
              ".read": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
              ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
              ".validate": "newData.val() === null || newData.isString()"
            }
          },
          "editorSessions": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('zaiko/shift/access/admins').child(auth.uid).val() === true)",
              ".write": "auth != null && auth.uid === $uid && newData.isString() && root.child('zaiko/shift/access/editorTokens').child(newData.val()).child('active').val() === true"
            }
          }
        },
        "sessions": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('zaiko/shift/access/admins').child(auth.uid).val() === true)",
            ".write": "auth != null && auth.uid === $uid && newData.isString() && root.child('zaiko/shift/access/tokens').child(newData.val()).child('active').val() === true"
          }
        },
        "meta": {
          ".read": "auth != null && (root.child('zaiko/shift/access/admins').child(auth.uid).val() === true || root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true || root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('active').val() === true)",
          ".write": "auth != null && root.child('zaiko/shift/access/admins').child(auth.uid).val() === true",
          "published": {
            ".write": "auth != null && root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true"
          },
          "updatedAt": {
            ".write": "auth != null && root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true"
          },
          "decidedMonths": {
            ".write": "auth != null && root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true"
          },
          "decidedDays": {
            ".write": "auth != null && root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true"
          },
          "storeMemo": {
            ".write": "auth != null && root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true"
          },
          "storeOff": {
            ".write": "auth != null && root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true"
          }
        },
        "staff": {
          ".read": "auth != null && root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true",
          "$staffKey": {
            ".read": "auth != null && (root.child('zaiko/shift/access/admins').child(auth.uid).val() === true || (root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('active').val() === true && root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('staffKey').val() === $staffKey))",
            ".write": "auth != null && (root.child('zaiko/shift/access/admins').child(auth.uid).val() === true || (root.child('zaiko/shift/access/editorTokens/' + root.child('zaiko/shift/access/editorSessions/' + auth.uid).val()).child('active').val() === true && data.exists() && newData.exists() && newData.child('nm').val() === data.child('nm').val() && newData.child('store').val() === data.child('store').val()))",
            "wish": {
              ".write": "auth != null && root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('active').val() === true && root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('staffKey').val() === $staffKey"
            },
            "notes": {
              ".write": "auth != null && root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('active').val() === true && root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('staffKey').val() === $staffKey"
            },
            "req": {
              ".write": "auth != null && root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('active').val() === true && root.child('zaiko/shift/access/tokens/' + root.child('zaiko/shift/sessions/' + auth.uid).val()).child('staffKey').val() === $staffKey"
            }
          }
        }
      }
    }
  }
}
